# =============================================================================
# Support-Ticket Triage Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All fields are validated by pydantic-settings on startup.

# ── Database ---------------------------------------------------------------------------
# SQLAlchemy async connection string (asyncpg for Postgres, aiosqlite for SQLite)
DATABASE_URL=postgresql+asyncpg://triage_user:triage_pass@localhost:5432/triage_db
# Number of connections to keep in the async pool (default: 20)
DATABASE_POOL_SIZE=20
# Max extra connections beyond pool_size for burst traffic (default: 10)
DATABASE_MAX_OVERFLOW=10

# ── Qdrant (Vector DB) -----------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=tickets

# ── LLM Provider (set one or both) -----------------------------------------------------
# Must be exactly "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI credentials (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic credentials (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Redis (background jobs / caching) ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ── Agent Config -----------------------------------------------------------------------
# Confidence below this → escalate to human (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.7
# Max agent loop iterations before forced escalation (1 – 10)
MAX_LOOP_RETRIES=3
# p95 latency budget in seconds (5 – 300)
TRIAGE_TIMEOUT_SECONDS=30
# Maximum concurrent triage runs (1 – 50)
MAX_CONCURRENT_TRIAGES=5
# Timeout for a single LLM classification call in seconds (1.0 – 60.0)
CLASSIFICATION_TIMEOUT_SECONDS=10.0
# Timeout for a single LLM draft generation call in seconds (1.0 – 120.0)
DRAFTING_TIMEOUT_SECONDS=15.0
# Timeout for vector retrieval operations in seconds (1.0 – 60.0)
RETRIEVAL_TIMEOUT_SECONDS=10.0

# ── Observability (OpenTelemetry) -------------------------------------------------------
OTLP_ENDPOINT=http://localhost:4317
# Must be one of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Evaluation --------------------------------------------------------------------------
EVAL_TICKETS_PATH=./data/eval_tickets.json

# ── Dashboard Authentication (v1 placeholder — replace with real auth in production) ----
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
