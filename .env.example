# =============================================================================
# Support-Ticket Triage Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# All fields are validated by pydantic-settings on startup.

# ── Environment -------------------------------------------------------------------------
# Must be "development", "staging", or "production"
ENVIRONMENT=development

# ── Database (Neon PostgreSQL) ----------------------------------------------------------
# Sign up at: https://neon.tech (free tier available)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Set to "require" for Neon (it requires SSL)
DATABASE_SSL_MODE=require
# Set to true for Neon serverless (avoids holding open connections)
DATABASE_USE_NULLPOOL=true
# Pool size (reduce for Neon free tier — 100 total connections across all workers)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_CONNECT_TIMEOUT=30

# ── Qdrant Cloud (Vector DB) -----------------------------------------------------------
# Sign up at: https://cloud.qdrant.io (free tier: 1GB storage)
# URL format: https://xxx.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
# Local Qdrant (used when QDRANT_URL is empty)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_TIMEOUT=60
QDRANT_COLLECTION=tickets

# ── LLM Provider (set one primary, optionally one fallback) -----------------------------
# Primary provider: "openai", "anthropic", "gemini", or "openrouter"
LLM_PROVIDER=gemini
# Optional fallback when primary fails
LLM_FALLBACK_PROVIDER=openrouter
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Google Gemini (primary) ------------------------------------------------------------
# Sign up at: https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- OpenRouter (fallback / free models) ------------------------------------------------
# Sign up at: https://openrouter.ai (free models available)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# --- OpenAI (alternative primary) -------------------------------------------------------
# Sign up at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# --- Anthropic (alternative primary) -----------------------------------------------------
# Sign up at: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=

# ── Redis (Upstash) ---------------------------------------------------------------------
# Sign up at: https://upstash.com (free tier: 10K commands/day)
# Use rediss:// for Upstash (TLS required)
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# ── Embeddings ---------------------------------------------------------------------------
# "openai" or "sentence_transformer" (local fallback, no API key needed)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_CACHE_TTL_SECONDS=86400

# ── Agent Config -----------------------------------------------------------------------
# Confidence below this → escalate to human (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.7
# Max agent loop iterations before forced escalation (1 – 10)
MAX_LOOP_RETRIES=3
# p95 latency budget in seconds (5 – 300)
TRIAGE_TIMEOUT_SECONDS=120
# Maximum concurrent triage runs (1 – 50)
MAX_CONCURRENT_TRIAGES=5
# Timeout for a single LLM classification call in seconds (1.0 – 60.0)
# The full classifier prompt (~2000 tokens, 8 few-shot examples) needs ~12s
# through LangChain on gemini-flash-lite-latest; 30s covers cold-start latency.
CLASSIFICATION_TIMEOUT_SECONDS=30
# Timeout for a single LLM draft generation call in seconds (1.0 – 120.0)
# Drafting is slower than classification due to RAG context; 30s avoids
# timeout-induced heuristic fallback.
DRAFTING_TIMEOUT_SECONDS=30
# Timeout for vector retrieval operations in seconds (1.0 – 60.0)
RETRIEVAL_TIMEOUT_SECONDS=10

# ── Observability (OpenTelemetry) -------------------------------------------------------
OTLP_ENDPOINT=http://localhost:4317
# Must be one of: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Retriever Cache ---------------------------------------------------------------------
RETRIEVER_CACHE_TTL_SECONDS=300

# ── Evaluation --------------------------------------------------------------------------
EVAL_TICKETS_PATH=./data/eval_tickets.json

# ── Dashboard Authentication (v1 placeholder — replace with real auth in production) ----
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
