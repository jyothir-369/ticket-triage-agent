# =============================================================================
# Support-Ticket Triage Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# -- Database ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://triage_user:triage_pass@localhost:5432/triage_db

# -- Qdrant (Vector DB) -----------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=tickets

# -- LLM Provider (set one or both) -----------------------------------------------------
LLM_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# -- Redis (background jobs / caching) ---------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -- Agent Config -----------------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.7     # Below this → escalate to human
MAX_LOOP_RETRIES=3           # Max retries before breaking out of an agent loop
TRIAGE_TIMEOUT_SECONDS=30    # p95 latency budget

# -- Observability (OpenTelemetry) -------------------------------------------------------
OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# -- Evaluation --------------------------------------------------------------------------
EVAL_TICKETS_PATH=./data/eval_tickets.json
