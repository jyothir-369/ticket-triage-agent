# =============================================================================
# Support-Ticket Triage Agent — Production Environment Template
#
# Copy to your deployment host (Render) and fill in real values.
# NEVER commit real credentials. This file exists so reviewers can see
# exactly which variables a production deployment needs.
#
# Reference plan for the cloud services:
#   - Database:  Neon (https://neon.tech)          free tier
#   - Redis:     Upstash (https://upstash.com)     free tier
#   - Vectors:   Qdrant Cloud (https://cloud.qdrant.io)  free 1GB tier
#   - LLM:       Gemini (https://aistudio.google.com) primary
#                OpenRouter (https://openrouter.ai) fallback
# =============================================================================

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Format: postgresql://user:password@host/database?sslmode=require
# Neon serverless requires SSL; the app auto-converts postgresql:// → asyncpg.
DATABASE_URL=postgresql://your_neon_user:your_neon_password@ep-xxx.us-east-2.aws.neon.tech/your_neondb?sslmode=require
DATABASE_SSL_MODE=require
DATABASE_USE_NULLPOOL=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# ── Redis (Upstash) ────────────────────────────────────────────────────────────
# Upstash requires rediss:// (TLS).
REDIS_URL=rediss://default:your_upstash_password@xxx.upstash.io:6379
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5

# ── Qdrant Cloud ───────────────────────────────────────────────────────────────
# URL format: https://xxx.qdrant.io:6333
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=tickets

# ── Primary LLM: Google Gemini ─────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest

# ── Fallback LLM: OpenRouter ───────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Provider routing ───────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter

# ── Dashboard authentication (Streamlit) ───────────────────────────────────────
# Set a strong, non-default password. Used by the dashboard login only.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-in-production

# ── Dashboard → API connectivity (Streamlit service only) ─────────────────────
API_URL=https://support-triage-api.onrender.com